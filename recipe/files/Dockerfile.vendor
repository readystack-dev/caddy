# =====================================================================
# VENDOR STAGE (online) — does ALL network work, emits a build-ready,
# fully-vendored tree so the offline build needs no network:
#   - caddy-src : custom main module depends on caddy/v2 @ v2.11.9;
#                 grpc + x/crypto x/net x/sys x/text + klauspost/compress raised to exact
#                 floors (raise-only), caddy/v2 asserted; go mod vendor
#   - chisel    : the runtime rootfs, cut by Canonical's chisel (pinned release and
#                 chisel-releases commit, checksummed) from Ubuntu's own .debs:
#                 rootfs.tar, debs/, packages.tsv, slices.txt and a generated dpkg
#                 status (chisel writes none); Dockerfile.offline.pinned lays it out
#                 FROM scratch
# Export:  docker build -f Dockerfile.vendor --target export \
#            --output type=local,dest=./vendored .
# =====================================================================
FROM golang:1.26.11-bookworm@sha256:dc40a13b61304647ed7e5d581d246b86413dfc29d63c6d018310feb93cd98fc0 AS caddyvendor
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY main.go .
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
# Resolve the custom main module. CVE floors mirror strategies/caddy.json dep_bumps and
# are applied RAISE-ONLY with floor() (gen_dockerfile's idiom): it raises a module only
# when the graph has it LOWER, never lowers it. A bare `go get m@vX` SETS m to vX, and
# MVS drags every module that needs more than vX down with it: chain 473 ran
# `go get google.golang.org/grpc@v1.82.1` against caddy v2.11.7 (which requires grpc
# v1.83.2) and Go silently downgraded caddy/v2 itself to v2.11.4, so an image labelled
# v2.11.7 shipped v2.11.4 + go-chi/chi v5.2.5 (GO-2026-5775/5777). Exact versions only,
# never @latest: an unbounded floor resolves differently on every vendor run.
# floor() fails closed (L-A133): `go list -mod=mod`, and only "not a known dependency" skips a module. The old
# `go list -m ... 2>/dev/null || true` read "missing go.sum entry" (left by the first floor that raised x/net)
# as "not a dependency" and silently skipped every later floor: chain 741 shipped go-jose v4.1.5 to the verdict
# with `floor go-jose v4.1.6` in this file. held() re-checks every floor after `go mod tidy`.
RUN floor() { e=$(mktemp); cur=$(go list -mod=mod -m -f '{{.Version}}' "$1" 2>"$e") || \
        { grep -q 'not a known dependency' "$e" && return 0; cat "$e" >&2; return 1; }; [ -n "$cur" ] || return 0; \
      [ "$(printf '%s\n%s\n' "$cur" "$2" | sort -V | tail -1)" = "$cur" ] || go mod edit -require="$1@$2"; } && \
    held() { e=$(mktemp); cur=$(go list -m -f '{{.Version}}' "$1" 2>"$e") || \
        { grep -q 'not a known dependency' "$e" && return 0; cat "$e" >&2; return 1; }; \
      [ "$(printf '%s\n%s\n' "$cur" "$2" | sort -V | tail -1)" = "$cur" ] || \
        { echo "floor $1 $2 did not take: the module resolved to $cur" >&2; return 1; }; } && \
    go mod init readystack/caddy-build && \
    go get github.com/caddyserver/caddy/v2@v2.11.9 && \
    floor google.golang.org/grpc v1.83.2 && \
    floor golang.org/x/crypto v0.58.0 && \
    floor golang.org/x/net v0.62.0 && \
    floor golang.org/x/sys v0.49.0 && \
    floor golang.org/x/text v0.43.0 && floor github.com/go-jose/go-jose/v4 v4.1.6 && \
    floor github.com/klauspost/compress v1.20.3 && \
    go mod tidy && \
    held google.golang.org/grpc v1.83.2 && held golang.org/x/crypto v0.58.0 && held golang.org/x/net v0.62.0 && held golang.org/x/sys v0.49.0 && held golang.org/x/text v0.43.0 && held github.com/go-jose/go-jose/v4 v4.1.6 && \
    held github.com/klauspost/compress v1.20.3
# Fail closed if anything above moved caddy off the release version.
RUN v=$(go list -m -f '{{.Version}}' github.com/caddyserver/caddy/v2) && echo "caddy/v2 resolved to $v" && \
    [ "$v" = v2.11.9 ] || { echo "caddy/v2 resolved to '$v', not v2.11.9: a dependency pin dragged it down" >&2; exit 1; }
RUN go mod vendor

# chiselled runtime (runtime_base): the files the slices need, cut from Ubuntu's own .debs by Canonical's chisel
FROM ubuntu:24.04@sha256:2198e4c65076e9cb0b3d695219df667c0e3b0072da64ca3c2648aca17dcecaf5 AS chiselcut
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl file zstd && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/chisel.tgz https://github.com/canonical/chisel/releases/download/v1.5.1/chisel_v1.5.1_linux_amd64.tar.gz && \
    echo "89612f46de83e850aae11fca26a32a22cc2964891f2cc538211b906787d2b83e4496fa203a5074e06a9932f1fbe84a73  /tmp/chisel.tgz" | sha384sum -c - && tar -xzf /tmp/chisel.tgz -C /usr/local/bin chisel && \
    curl -fsSL -o /tmp/releases.tgz https://github.com/canonical/chisel-releases/archive/f2600d3aa90123db6d44bb1441a99afc8b5847d9.tar.gz && \
    echo "e5b4484bb283149ed7fc0f42ad2194fed28cae0bf1036704853d60ec31298bef  /tmp/releases.tgz" | sha256sum -c - && \
    mkdir -p /opt/chisel-releases && tar -xzf /tmp/releases.tgz -C /opt/chisel-releases --strip-components=1
RUN mkdir -p /rootfs /cache && XDG_CACHE_HOME=/cache chisel cut --release /opt/chisel-releases --root /rootfs base-files_base base-files_release-info base-files_chisel base-passwd_data ca-certificates_data tzdata_zoneinfo dash_bins coreutils_output-of-entire-files coreutils_env coreutils_echo coreutils_test coreutils_tr-utility coreutils_sort coreutils_head coreutils_tail coreutils_cut coreutils_printf coreutils_working-context coreutils_system-context coreutils_basename coreutils_dirname coreutils_rm-utility coreutils_ln-utility coreutils_readlink coreutils_date coreutils_timeout coreutils_delaying libcap2-bin_bins
RUN set -eu; mkdir -p /chisel/debs /rootfs/var/lib/dpkg; : > /tmp/status; : > /chisel/packages.tsv; \
    for f in /cache/chisel/sha256/* /cache/chisel/sha512/*; do [ -f "$f" ] && file "$f" | grep -q "Debian binary package" || continue; \
      p=$(dpkg-deb -f "$f" Package); v=$(dpkg-deb -f "$f" Version); \
      cp "$f" "/chisel/debs/${p}_${v}.deb"; printf '%s\t%s\t%s\n' "$p" "$v" "$(sha256sum < "$f" | cut -c1-64)" >> /chisel/packages.tsv; done; \
    [ -s /chisel/packages.tsv ] || { echo "no .deb found in the chisel cache" >&2; exit 1; }; \
    LC_ALL=C sort -o /chisel/packages.tsv /chisel/packages.tsv; \
    cut -f1,2 /chisel/packages.tsv | while IFS="$(printf '\t')" read -r p v; do \
      dpkg-deb -f "/chisel/debs/${p}_${v}.deb" | sed '/^Package:/a Status: install ok installed' >> /tmp/status; echo >> /tmp/status; done; \
    install -m 0644 /tmp/status /rootfs/var/lib/dpkg/status; \
    mkdir -p /rootfs/var/lib/dpkg/info; [ -s /rootfs/var/lib/chisel/manifest.wall ] || \
      { echo "no chisel manifest (/var/lib/chisel/manifest.wall): the base-files_chisel slice is missing" >&2; exit 1; }; \
    zstd -dc /rootfs/var/lib/chisel/manifest.wall | grep '"kind":"path"' | \
      sed -n 's/.*"path":"\([^"]*\)".*"slices":\[\([^]]*\)\].*/\1 \2/p' | \
      while read -r path slices; do path=${path%/}; if [ -z "$path" ]; then continue; fi; \
        for s in $(echo "$slices" | tr -d '"' | tr ',' ' '); do echo "$path" >> "/rootfs/var/lib/dpkg/info/${s%%_*}.list"; done; done; \
    cut -f1 /chisel/packages.tsv | while read -r p; do l="/rootfs/var/lib/dpkg/info/$p.list"; [ -f "$l" ] || : > "$l"; \
      LC_ALL=C sort -u -o "$l" "$l"; \
      while read -r f; do if [ -f "/rootfs$f" ] && [ ! -L "/rootfs$f" ]; then (cd /rootfs && md5sum "${f#/}"); fi; done < "$l" \
        > "/rootfs/var/lib/dpkg/info/$p.md5sums"; done; \
    [ "$(ls /rootfs/var/lib/dpkg/info/*.md5sums | wc -l)" = "$(wc -l < /chisel/packages.tsv)" ] || \
      { echo "/var/lib/dpkg/info does not name every package of the cut" >&2; exit 1; }; \
    { echo "chisel v1.5.1"; echo "chisel-releases f2600d3aa90123db6d44bb1441a99afc8b5847d9"; for s in base-files_base base-files_release-info base-files_chisel base-passwd_data ca-certificates_data tzdata_zoneinfo dash_bins coreutils_output-of-entire-files coreutils_env coreutils_echo coreutils_test coreutils_tr-utility coreutils_sort coreutils_head coreutils_tail coreutils_cut coreutils_printf coreutils_working-context coreutils_system-context coreutils_basename coreutils_dirname coreutils_rm-utility coreutils_ln-utility coreutils_readlink coreutils_date coreutils_timeout coreutils_delaying libcap2-bin_bins; do echo "$s"; done; } > /chisel/slices.txt; \
    tar --sort=name --numeric-owner --format=posix --pax-option=delete=atime,delete=ctime -cf /chisel/rootfs.tar -C /rootfs . && \
    echo "chiselled rootfs: $(wc -l < /chisel/packages.tsv) packages, $(du -sh /rootfs | cut -f1)"
# CVE floors on OS packages mirror strategies/caddy.json apt_refresh (hand kits do not read it): a package
# of the cut must be at or above its fixed version, else the vendor run fails here instead of shipping it; a floor
# whose package the cut does not carry has nothing to raise (the image does not ship it).
RUN atleast() { v=$(awk -F'\t' -v p="$1" '$1 == p {print $2}' /chisel/packages.tsv); \
      if [ -z "$v" ]; then echo "apt floor $1 $2: not in the cut"; return 0; fi; \
      dpkg --compare-versions "$v" ge "$2" || { echo "apt floor $1 $2 did not take: $v" >&2; return 1; }; \
      echo "apt floor $1 $2: $v"; } && \
    atleast apt 2.8.4ubuntu0.1 && atleast libapt-pkg6.0t64 2.8.4ubuntu0.1 && atleast libpcre2-8-0 10.42-4ubuntu2.2 && atleast libc6 2.39-0ubuntu8.12

FROM scratch AS export
COPY --from=caddyvendor /src /caddy-src
COPY --from=chiselcut /chisel /chisel
